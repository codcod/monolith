# Local/dev settings for docker compose. Not secrets — just the defaults for
# local development. Copy this file to `.env` (gitignored) to use it; `.env`
# is loaded automatically by `docker compose` and by `just`.
#
# POSTGRES_USER/PASSWORD/DB are also hardcoded into each service's
# platform/*/config/config.toml `db` DSN — config.toml has no env-var
# expansion, so if you change these, update those DSNs to match.
POSTGRES_USER=stelo
POSTGRES_PASSWORD=stelo
POSTGRES_DB=stelo
POSTGRES_PORT=5432

# Host port inbox's HTTP API is published on (traffic/dispatcher have no
# public port — they're stream consumers only).
INBOX_PORT=8080

# Host port the Relay Console admin dashboard is published on.
ADMIN_PORT=8081
