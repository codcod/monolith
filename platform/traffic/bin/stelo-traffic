#!/usr/bin/env python

import argparse

from aiohttp import web

from stelo.base.config import read_config, setup_app
from stelo.traffic.app import build_app

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("config", help="Configuration file")
    args = parser.parse_args()

    config = read_config(args.config)
    setup_app(config["traffic"])

    web.run_app(build_app(config["traffic"]), host="0.0.0.0", port=8080)

# vim: ft=py
