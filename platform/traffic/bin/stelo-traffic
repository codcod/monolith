#!/usr/bin/env python

import asyncio
import argparse

from stelo.traffic.config import setup_app, read_config
from stelo.traffic.app import run_module

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('config', help='Configuration file')
    args = parser.parse_args()

    config = read_config(args.config)
    setup_app(config['traffic'])
    asyncio.run(run_module(config))

# vim: ft=py