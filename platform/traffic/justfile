repo_root := `git rev-parse --show-toplevel`

# List available recipes (default when running `just` with no args)
[group('dev')]
list:
    @just --list

# Sync this package + its deps into the shared workspace venv at the repo root
[group('dev')]
install:
    uv sync --project {{ repo_root }} --package stelo-traffic --inexact

# Run against the dockerized postgres/rabbitmq — `just up` first
[group('dev')]
run: install
    uv run --project {{ repo_root }} --frozen bin/stelo-traffic config/config.toml

[group('test')]
test:
    uv run --project {{ repo_root }} --package stelo-traffic --group dev pytest -q

# Repository/UoW against a real Postgres — needs `just up` first. Kept out
# of the default `test` recipe so that one stays fast and docker-free.
[group('test')]
test-integration:
    RUN_INTEGRATION_TESTS=1 uv run --project {{ repo_root }} --package stelo-traffic --group dev pytest tests/integration -q

# Only exercises /health — traffic's real job is a stream consumer, which
# k6 doesn't drive. Needs a live instance: `just up`, or `just run`.
[group('test')]
perf:
    k6 run tests/performance/k6/script.js

[group('db')]
migrate: install
    uv run --project {{ repo_root }} --frozen python -m alembic upgrade head

[group('db')]
migration name: install
    uv run --project {{ repo_root }} --frozen python -m alembic revision --autogenerate -m "{{ name }}"

[group('db')]
downgrade rev="-1": install
    uv run --project {{ repo_root }} --frozen python -m alembic downgrade {{ rev }}

# Auto-fix and reformat this module's code
[group('quality')]
fmt: install
    uv run --project {{ repo_root }} --frozen ruff check --fix src tests migrations/env.py
    uv run --project {{ repo_root }} --frozen ruff format src tests migrations/env.py

# Lint + format-check + type-check this module (ty only checks src — tests
# use loose fakes/doubles that aren't meant to type-check as the real thing)
[group('quality')]
lint: install
    uv run --project {{ repo_root }} --frozen ruff check src tests migrations/env.py
    uv run --project {{ repo_root }} --frozen ruff format --check src tests migrations/env.py
    uv run --project {{ repo_root }} --frozen ty check src

# Image build only — the container needs postgres/rabbitmq to do anything
# useful, so run it via `just up`, not standalone.
[group('docker')]
docker-build:
    docker build -f Dockerfile -t stelo-traffic {{ repo_root }}

# Boot this service via compose (shared postgres/rabbitmq start automatically as dependencies)
[group('compose')]
up:
    docker compose -f {{ repo_root }}/compose.yaml up -d --build traffic

# Stop and remove this service's own containers only — leaves shared postgres/rabbitmq untouched
[group('compose')]
down:
    docker compose -f {{ repo_root }}/compose.yaml rm -sf traffic traffic-migrate

# Tail this service's logs (app + its migration)
[group('compose')]
logs:
    docker compose -f {{ repo_root }}/compose.yaml logs -f traffic traffic-migrate

[group('dev')]
clean:
    find . -name __pycache__ -type d -exec rm -rf {} +

# Mirror this module's GHA job (ci_traffic.yml → python_reusable.yml):
# lint + format-check + type-check + test
[group('ci')]
ci: lint test
