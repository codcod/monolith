#!/usr/bin/env python

import argparse
import os
import signal
import socket
import sys

from aiohttp import web
from stelo.base.config import Config, read_config, setup_app
from stelo.inbox.app import build_app


def _serve_one(config: Config) -> None:
    """
    Run one HTTP worker on its own event loop, bound to a socket shared
    (via SO_REUSEPORT) with every other worker process — the kernel
    load-balances incoming connections across them. aiohttp is a
    single-threaded asyncio server, so one process only ever uses one CPU
    core; this is how you use the rest of them.
    """
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    sock.bind(('0.0.0.0', 8080))
    web.run_app(build_app(config), sock=sock)


def _serve(config: Config, workers: int) -> None:
    """
    Fork `workers` worker processes (see `_serve_one`) and supervise them:
    forward SIGTERM/SIGINT to every worker so `docker stop` reaches them
    too, then wait for all of them to exit before this process does.

    No auto-restart of a crashed worker — this is a capacity fix, not a
    process manager; add restart-on-crash if that's ever needed too.
    """
    pids = []
    for _ in range(workers):
        pid = os.fork()
        if pid == 0:
            _serve_one(config)
            sys.exit(0)
        pids.append(pid)

    def _forward(signum: int, _frame: object) -> None:
        for pid in pids:
            os.kill(pid, signum)

    signal.signal(signal.SIGTERM, _forward)
    signal.signal(signal.SIGINT, _forward)

    for _ in pids:
        os.wait()


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('config', help='Configuration file')
    args = parser.parse_args()

    config = read_config(args.config)
    setup_app(config['inbox'])

    workers = config['inbox'].get('workers', 1)
    if workers > 1:
        _serve(config['inbox'], workers)
    else:
        _serve_one(config['inbox'])

