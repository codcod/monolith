repo_root := `git rev-parse --show-toplevel`

# List available recipes (default when running `just` with no args)
[group('dev')]
list:
    @just --list

# Sync this package + its deps into the shared workspace venv at the repo root
[group('dev')]
install:
    uv sync --project {{ repo_root }} --package stelo-admin --inexact

# Run against the dockerized postgres — `just up` first
[group('dev')]
run: install
    uv run --project {{ repo_root }} bin/stelo-admin config/config.toml

[group('test')]
test: install
    uv run --project {{ repo_root }} pytest -q

# Auto-fix and reformat this module's code
[group('quality')]
fmt: install
    uv run --project {{ repo_root }} ruff check --fix src tests
    uv run --project {{ repo_root }} ruff format src tests

# Lint + format-check + type-check this module (ty only checks src — tests
# use loose fakes/doubles that aren't meant to type-check as the real thing)
[group('quality')]
lint: install
    uv run --project {{ repo_root }} ruff check src tests
    uv run --project {{ repo_root }} ruff format --check src tests
    uv run --project {{ repo_root }} ty check src

# Image build only — the container needs postgres (with inbox/traffic/
# dispatcher's schemas already migrated) to do anything useful, so run it
# via `just up`, not standalone.
[group('docker')]
docker-build:
    docker build -f Dockerfile -t stelo-admin {{ repo_root }}

# Boot this service via compose (shared postgres starts automatically as a dependency)
[group('compose')]
up:
    docker compose -f {{ repo_root }}/compose.yaml up -d --build admin

# Stop and remove this service's own container only — leaves shared postgres/rabbitmq untouched
[group('compose')]
down:
    docker compose -f {{ repo_root }}/compose.yaml rm -sf admin

# Tail this service's logs
[group('compose')]
logs:
    docker compose -f {{ repo_root }}/compose.yaml logs -f admin

[group('dev')]
clean:
    find . -name __pycache__ -type d -exec rm -rf {} +

# Mirror this module's GHA job (ci_admin.yml → python_reusable.yml):
# lint + format-check + type-check + test
[group('ci')]
ci: lint test
